# MediSys database settings (SQL Server)
#
# Copy this file to db.properties in the same folder and put in YOUR own
# SQL Server login. db.properties is in .gitignore, so your password is never
# pushed to GitHub.

db.url=jdbc:sqlserver://localhost:1433;databaseName=MediSysDB;encrypt=false;trustServerCertificate=true
db.user=sa
db.password=change-me
