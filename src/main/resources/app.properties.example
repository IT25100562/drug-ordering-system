# MediSys app settings (optional)
#
# Copy this file to app.properties in the same folder. app.properties is in
# .gitignore, because the Cloudinary secret goes in here.
# On the live server these come from environment variables instead
# (CLOUDINARY_URL, CLOUDINARY_FOLDER, STORAGE_LOCAL_DIR).

# Cloudinary (Dashboard -> "API environment variable"). When this is set,
# uploaded prescriptions and profile photos are stored in Cloudinary.
# Leave it empty to keep files in a local folder instead.
cloudinary.url=
# Folder inside Cloudinary (default: medisys)
cloudinary.folder=

# Folder for uploaded files when Cloudinary is NOT used.
# Leave empty for <your home folder>/medisys-uploads
storage.local.dir=
