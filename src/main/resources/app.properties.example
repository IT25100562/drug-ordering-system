# MediSys app settings (optional)
#
# Without an app.properties file the default below is used, so you only need
# this when you want something different. To use it, copy this file to
# app.properties in the same folder. app.properties is in .gitignore, because
# cloud storage keys will go in here later.

# Folder where uploaded prescriptions and profile photos are kept
# (see common/FileStorage.java). Leave empty for <your home folder>/medisys-uploads
storage.local.dir=
