<%--
    Shared page top: <head>, the menu bar for the logged in role, and
    success / error / info messages.
    Shared file - agree with the team before changing it.

    Every page declares a String called pageTitle first, then includes this:

        <% String pageTitle = "My Prescriptions"; %>
        <%@ include file="../common/header.jspf" %>
--%>
<%@ page import="com.medisys.user.User" %>
<%@ page import="com.medisys.cart.CartDAO" %>
<%@ page import="com.medisys.cart.WishlistDAO" %>
<%@ page import="com.medisys.delivery.DeliveryDAO" %>
<%@ page import="com.medisys.delivery.NotificationDAO" %>
<%@ page import="com.medisys.order.OrderDAO" %>
<%@ page import="com.medisys.prescription.PrescriptionDAO" %>
<%@ page import="com.medisys.common.SessionUtil" %>
<%@ page import="com.medisys.common.TextUtil" %>
<%
    String ctx = request.getContextPath();
    User currentUser = SessionUtil.currentUser(request);

    // Messages stored just before a redirect (see SessionUtil.flash).
    String successMessage = SessionUtil.takeFlash(request, "success");
    String errorMessage = SessionUtil.takeFlash(request, "error");
    String infoMessage = SessionUtil.takeFlash(request, "info");

    // Badges in the customer menu. A database problem must not break every page.
    int headerCartCount = 0;
    int headerWishlistCount = 0;
    int headerUnreadCount = 0;
    int headerPendingCount = 0;
    int headerNewOrderCount = 0;
    int headerDeliveryCount = 0;
    try {
        if (currentUser != null && currentUser.isCustomer()) {
            headerCartCount = new CartDAO().countItems(currentUser.getId());
            headerWishlistCount = new WishlistDAO().countItems(currentUser.getId());
            headerUnreadCount = new NotificationDAO().countUnread(currentUser.getId());
        } else if (currentUser != null && currentUser.isPharmacist()) {
            headerPendingCount = new PrescriptionDAO().countForDashboard().get("PENDING");
        } else if (currentUser != null && currentUser.isAdmin()) {
            headerNewOrderCount = new OrderDAO().countByStatus().get("PAID");
            // deliveries still waiting for a rider
            headerDeliveryCount = new DeliveryDAO().countByStatus(null).get("UNASSIGNED");
        } else if (currentUser != null && currentUser.isDeliveryStaff()) {
            // the rider's open deliveries
            headerDeliveryCount = new DeliveryDAO().countByStatus(currentUser.getId()).get("ACTIVE");
            headerUnreadCount = new NotificationDAO().countUnread(currentUser.getId());
        }
    } catch (java.sql.SQLException e) {
        log("Could not load the menu counts", e);
    }

    // Marks the menu link of the page we are on.
    // Pages are reached through a servlet forward, so the browser's address is
    // kept in the "forward" attributes.
    String currentPath = request.getRequestURI().substring(ctx.length());
    String currentQuery = request.getQueryString();
    if (request.getAttribute("jakarta.servlet.forward.request_uri") != null) {
        currentPath = ((String) request.getAttribute("jakarta.servlet.forward.request_uri")).substring(ctx.length());
        currentQuery = (String) request.getAttribute("jakarta.servlet.forward.query_string");
    }

    // This page's address, sent as "returnTo" by forms so the user comes back here.
    String currentUrl = currentQuery == null ? currentPath : currentPath + "?" + currentQuery;
    if (!TextUtil.isSafeLocalPath(currentUrl)) {
        currentUrl = currentPath;
    }
%>
<%!
    // "active" when the menu link belongs to the current page.
    private String activeIf(String currentPath, String prefix) {
        return currentPath.equals(prefix) || currentPath.startsWith(prefix + "/") ? "active" : "";
    }

    // A round profile picture, or the initials when there is no photo (user accounts).
    // cssClass: "avatar", "avatar small" or "avatar large".
    private String avatar(String ctx, int userId, boolean hasPhoto, String name, String cssClass) {
        if (hasPhoto) {
            return "<img class=\"" + cssClass + "\" src=\"" + ctx + "/users/photo?id=" + userId
                    + "\" alt=\"Photo of " + TextUtil.html(name) + "\">";
        }
        User temp = new User();
        temp.setFullName(name);
        return "<span class=\"" + cssClass + " initials\" aria-hidden=\"true\">" + TextUtil.html(temp.getInitials()) + "</span>";
    }

    private String avatar(String ctx, User user, String cssClass) {
        return avatar(ctx, user.getId(), user.hasPhoto(), user.getFullName(), cssClass);
    }

    // What goes inside a medicine tile: the product photo, or a short text such as "TAB".
    // size: the width in pixels the photo is shown at (Cloudinary sends it at that size).
    private String thumbInner(String ctx, com.medisys.medicine.Medicine m, int size) {
        if (m.hasImage()) {
            return "<img src=\"" + TextUtil.html(m.getImageUrl(ctx, size * 2)) + "\" alt=\"\" loading=\"lazy\" width=\""
                    + size + "\" height=\"" + size + "\">";
        }
        return m.getThumbText();
    }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= TextUtil.html(pageTitle) %> | MediSys</title>
    <meta name="description" content="MediSys - order genuine medicines online. Prescriptions checked by a pharmacist, delivered to your door.">
    <meta name="theme-color" content="#0b6b5e">
    <link rel="icon" type="image/svg+xml" href="<%= ctx %>/images/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="<%= ctx %>/css/style.css">
    <script src="<%= ctx %>/js/app.js" defer></script>
</head>
<body data-ctx="<%= ctx %>">

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <a class="brand" href="<%= ctx %>/" aria-label="MediSys home">
        <svg class="brand-mark" viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
            <rect width="40" height="40" rx="11" fill="#0b6b5e"/>
            <path d="M16 9h8v7h7v8h-7v7h-8v-7H9v-8h7z" fill="#ffffff"/>
            <circle cx="31" cy="31" r="5" fill="#ffb703"/>
        </svg>
        <span class="brand-text">MediSys<small>Online Pharmacy</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open the menu">
        <span></span><span></span><span></span>
    </button>
    <nav aria-label="Main menu" id="main-nav">
        <a class="<%= activeIf(currentPath, "/medicines") %>" href="<%= ctx %>/medicines">Medicines</a>

        <% if (currentUser == null) { %>
            <a class="<%= activeIf(currentPath, "/login") %>" href="<%= ctx %>/login">Log in</a>
            <a class="nav-cta <%= activeIf(currentPath, "/register") %>" href="<%= ctx %>/register">Register</a>

        <% } else { %>
            <% if (currentUser.isCustomer()) { %>
                <a class="<%= activeIf(currentPath, "/prescriptions") %>" href="<%= ctx %>/prescriptions">Prescriptions</a>
                <a class="<%= activeIf(currentPath, "/orders") %>" href="<%= ctx %>/orders">Orders</a>
                <a class="<%= activeIf(currentPath, "/wishlist") %>" href="<%= ctx %>/wishlist">Wishlist<span
                   class="count <%= headerWishlistCount == 0 ? "hidden" : "" %>" data-wishlist-count><%= headerWishlistCount %></span></a>
                <a class="<%= activeIf(currentPath, "/cart") %>" href="<%= ctx %>/cart">Cart<span
                   class="count <%= headerCartCount == 0 ? "hidden" : "" %>" data-cart-count><%= headerCartCount %></span></a>
            <% } else if (currentUser.isAdmin()) { %>
                <a class="<%= activeIf(currentPath, "/admin/medicines") %>" href="<%= ctx %>/admin/medicines">Inventory</a>
                <a class="<%= activeIf(currentPath, "/admin/orders") %>" href="<%= ctx %>/admin/orders">Orders<span
                   class="count <%= headerNewOrderCount == 0 ? "hidden" : "" %>"><%= headerNewOrderCount %></span></a>
                <a class="<%= activeIf(currentPath, "/staff/deliveries") %>" href="<%= ctx %>/staff/deliveries">Deliveries<span
                   class="count <%= headerDeliveryCount == 0 ? "hidden" : "" %>" title="Waiting for a rider"><%= headerDeliveryCount %></span></a>
                <a class="<%= activeIf(currentPath, "/admin/categories") %>" href="<%= ctx %>/admin/categories">Categories</a>
                <a class="<%= activeIf(currentPath, "/admin/reports") %>" href="<%= ctx %>/admin/reports">Reports</a>
                <a class="<%= activeIf(currentPath, "/admin/users") %>" href="<%= ctx %>/admin/users">Users</a>
            <% } else if (currentUser.isPharmacist()) { %>
                <a class="<%= activeIf(currentPath, "/pharmacist") %>" href="<%= ctx %>/pharmacist/dashboard">Verification Dashboard<span
                   class="count <%= headerPendingCount == 0 ? "hidden" : "" %>"><%= headerPendingCount %></span></a>
            <% } else if (currentUser.isDeliveryStaff()) { %>
                <a class="<%= activeIf(currentPath, "/staff") %>" href="<%= ctx %>/staff/deliveries">My Deliveries<span
                   class="count <%= headerDeliveryCount == 0 ? "hidden" : "" %>"><%= headerDeliveryCount %></span></a>
            <% } %>
            <% if (currentUser.isCustomer() || currentUser.isDeliveryStaff()) { %>
                <a class="bell <%= activeIf(currentPath, "/notifications") %>" href="<%= ctx %>/notifications"
                   title="Notifications" aria-label="Notifications<%= headerUnreadCount > 0 ? ", " + headerUnreadCount + " new" : "" %>">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm7-6V11a7 7 0 0 0-5.5-6.84V3.5a1.5 1.5 0 0 0-3 0v.66A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2z"/></svg><span
                   class="count <%= headerUnreadCount == 0 ? "hidden" : "" %>"><%= headerUnreadCount %></span></a>
            <% } %>

            <a class="who <%= activeIf(currentPath, "/account") %>" href="<%= ctx %>/account/profile"
               title="My profile (<%= TextUtil.html(currentUser.getEmail()) %>)">
                <%= avatar(ctx, currentUser, "avatar small") %>
                <span><%= TextUtil.html(currentUser.getFirstName()) %>
                <small><%= TextUtil.html(currentUser.getRole().getLabel()) %></small></span>
            </a>
            <form class="logout" method="post" action="<%= ctx %>/logout">
                <button type="submit">Log out</button>
            </form>
        <% } %>
    </nav>
</header>

<main class="page" id="main">

<% if (successMessage != null) { %>
    <div class="message success" role="status" data-autohide><%= TextUtil.html(successMessage) %></div>
<% } %>
<% if (infoMessage != null) { %>
    <div class="message info" role="status"><%= TextUtil.html(infoMessage) %></div>
<% } %>
<% if (errorMessage != null) { %>
    <div class="message error" role="alert"><%= TextUtil.html(errorMessage) %></div>
<% } %>
